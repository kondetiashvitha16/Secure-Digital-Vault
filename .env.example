# Application Server Port
PORT=5000

# MongoDB Connection String
# Local MongoDB example: mongodb://127.0.0.1:27017/secure_digital_vault
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/secure_digital_vault
# If local MongoDB is not running, the application will automatically fall back to an in-memory MongoDB instance for testing/demo.
MONGODB_URI=mongodb://127.0.0.1:27017/secure_digital_vault

# JWT Secret Key (Use a strong, random string)
JWT_SECRET=super_secret_secure_digital_vault_jwt_key_2026_987654321

# JWT Expiration Time (e.g., 24h, 7d, 3600s)
JWT_EXPIRES_IN=24h

# AES-256 Encryption Key (Must be exactly 32 bytes / 64 hexadecimal characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_ENCRYPTION_KEY=e4d2a1b9f7c385419028eab716d93425081faec6291b7e43da52c80914bf8201

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
